# Copie este arquivo para .env e ajuste os valores. NUNCA comite o .env real.
SECRET_KEY=gere-uma-chave-aleatoria-longa-aqui
# Chave separada para autorizar a criação de usuários ADMIN pela tela
# /login/criar-admin. Recomendado: use um valor DIFERENTE da SECRET_KEY.
ADMIN_SETUP_KEY=gere-outra-chave-aleatoria-so-para-isso
ESCOLA_DB_PATH=instance/sistema_escolar.db
ESCOLA_ANO_LETIVO=2026
# Limites de upload em MB. Aumente se seus arquivos forem maiores que isso.
MAX_UPLOAD_MB=5
MAX_PDF_UPLOAD_MB=150

# Ligue para "1" só quando o sistema estiver atrás de HTTPS de verdade
# (qualquer hospedagem séria na internet). Deixe "0" em desenvolvimento local.
ESCOLA_FORCE_HTTPS=0

# Em hospedagem na nuvem, aponte para um disco/volume PERSISTENTE (o banco
# de dados e as fotos moram aqui). Deixe sem definir para uso local.
# ESCOLA_DATA_DIR=/var/data
